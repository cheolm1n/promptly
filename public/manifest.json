{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "manifest_version": 3,
  "name": "promptly",
  "version": "1.0.2",
  "description": "A Chrome extension for managing prompt templates and delivering them to AI services.",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/appicon_purple_16.png",
      "32": "icons/appicon_purple_32.png",
      "64": "icons/appicon_purple_64.png",
      "128": "icons/appicon_purple_128.png"
    }
  },
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "128": "icons/appicon_purple_128.png"
  },
  "default_locale": "en"
}
